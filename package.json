{
  "name": "@dannysir/js-te",
  "version": "0.9.3",
  "description": "JavaScript test library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "node": "./dist/browser-node-stub.mjs",
      "browser": "./dist/browser.mjs",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./src/mock/store.js": "./src/mock/store.js"
  },
  "bin": {
    "js-te": "bin/cli.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c",
    "test": "node bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "types/",
    "index.js"
  ],
  "keywords": [
    "javascript",
    "test",
    "testing",
    "jest",
    "mocking"
  ],
  "author": "dannysir",
  "license": "ISC",
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysir/js-te-package.git"
  },
  "bugs": {
    "url": "https://github.com/dannysir/js-te-package/issues"
  },
  "homepage": "https://dannysir-labs.vercel.app/en/libraries/js-te"
}
